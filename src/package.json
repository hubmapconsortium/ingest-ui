{
  "name": "ingest-ui",
  "version": "2.7.2",
  "private": true,
  "homepage": ".",
  "dependencies": {
    "@daypicker/react": "^10.0.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/x-data-grid": "^9.10.1",
    "@mui/x-date-pickers": "^9.10.1",
    "axios": "^1.18.1",
    "bootstrap": "^5.2.0-beta1",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.12",
    "elastic-builder": "^4.1.0",
    "env-cmd": "^11.0.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-idle-timer": "^5.7.3",
    "react-router": "^8.3.0",
    "react-spinners": "0.17.0",
    "react-tooltip": "^6.0.8"
  },
  "devDependencies": {
    "@datadog/datadog-ci": "^5.21.2",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.4",
    "cypress": "^15.19.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "resolutions": {
    "immer": "9.0.7",
    "ansi-html": "https://registry.yarnpkg.com/ansi-html-community/-/ansi-html-community-0.0.8.tgz",
    "ansi-regex": "5.0.1",
    "nth-check": "2.0.1",
    "glob-parent": "6.0.1",
    "browserslist": "4.18.1"
  },
  "overrides": {
    "form-data": "4.0.6",
    "tmp": "0.2.7"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "build:compat": "NODE_OPTIONS='--trace-deprecation' vite build",
    "build:tags": "env-cmd -f envs/env.tags -- vite build",
    "build:sourcemaps": "GENERATE_SOURCEMAP=true vite build",
    "lint": "eslint src cypress scripts cypress.config.js vite.config.mjs eslint.config.mjs",
    "hooks:install": "git config core.hooksPath src/.githooks",
    "css:sync-staged": "node ./scripts/sync-app-css.js",
    "secrets:scan": "node ./scripts/scan-staged-secrets.js",
    "secrets:self-test": "node ./scripts/scan-staged-secrets.js --self-test",
    "test:all": "npm run test:v && npm run test:c",
    "test:c": "node ./scripts/test-cypress.js",
    "test:v": "bash -o pipefail -c 'mkdir -p .test-results && vitest run 2>&1 | tee .test-results/vitest.log'",
    "verify:production-routing": "node ./scripts/verify-production-routing.js",
    "verify:react19": "npm run lint && npm run test:v && npm run build && npm run build:tags && npm run verify:production-routing",
    "verify:docker-config": "cd ../docker && ./docker-development.sh config",
    "verify:docker-build": "cd ../docker && ./docker-development.sh build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
